# Replace paths and IDs with values from the actual NAS.
ANALYZER_IMAGE=nas-storage-analyzer:local
APP_DATA_PATH=/replace/with/local/app-data
APP_CONFIG_PATH=./config.yaml
SOURCE_PATH=/replace/with/actual/shared-folder
APP_UID=1000
APP_GID=1000
# Loopback is safe by default. Use the NAS LAN IP for browser access.
NAS_BIND_IP=127.0.0.1
APP_PORT=3010
APP_TIMEZONE=UTC
APP_MEMORY_LIMIT=1024m
APP_CPUS=2.0
