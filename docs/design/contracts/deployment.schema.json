{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "config_version",
    "server",
    "storage",
    "approved_mounts",
    "security",
    "resources",
    "sampling"
  ],
  "properties": {
    "config_version": {
      "const": 2
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listen",
        "default_timezone",
        "trusted_proxy_cidrs",
        "allow_insecure_lan_http"
      ],
      "properties": {
        "listen": {
          "type": "string",
          "minLength": 1
        },
        "default_timezone": {
          "type": "string",
          "minLength": 1
        },
        "trusted_proxy_cidrs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allow_insecure_lan_http": {
          "type": "boolean"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_dir",
        "approved_output_roots",
        "data_budget_bytes",
        "hash_cache_budget_bytes"
      ],
      "properties": {
        "data_dir": {
          "type": "string",
          "pattern": "^/",
          "minLength": 1
        },
        "approved_output_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/",
            "minLength": 1
          }
        },
        "data_budget_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        },
        "hash_cache_budget_bytes": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        }
      }
    },
    "approved_mounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "container_path",
          "writable",
          "allow_submounts"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "container_path": {
            "type": "string",
            "pattern": "^/",
            "minLength": 1
          },
          "writable": {
            "type": "boolean"
          },
          "allow_submounts": {
            "const": false
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_write_operations",
        "session_idle_minutes",
        "session_absolute_hours",
        "reauth_minutes"
      ],
      "properties": {
        "allow_write_operations": {
          "type": "boolean"
        },
        "session_idle_minutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 1440
        },
        "session_absolute_hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "reauth_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_running_scans",
        "max_queued_scans",
        "metadata_workers",
        "hash_workers",
        "hash_read_limit_mib_s",
        "max_open_files",
        "api_memory_budget_mib",
        "worker_memory_budget_mib",
        "max_parallel_exports"
      ],
      "properties": {
        "max_running_scans": {
          "const": 1
        },
        "max_queued_scans": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "metadata_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "hash_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "hash_read_limit_mib_s": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "max_open_files": {
          "type": "integer",
          "minimum": 16,
          "maximum": 1024
        },
        "api_memory_budget_mib": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096,
          "description": "Soft process budget and pressure-response threshold in MiB, not a hard RSS limit or a Rust runtime switch. Bound buffers and DB caches; monitor and apply admission/cancellation policy. Container cgroup supplies the overall hard limit."
        },
        "worker_memory_budget_mib": {
          "type": "integer",
          "minimum": 128,
          "maximum": 16384,
          "description": "Soft process budget and pressure-response threshold in MiB, not a hard RSS limit or a Rust runtime switch. Bound buffers and DB caches; monitor and apply admission/cancellation policy. Container cgroup supplies the overall hard limit."
        },
        "max_parallel_exports": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval_minutes",
        "raw_retention_days",
        "daily_retention_days"
      ],
      "properties": {
        "interval_minutes": {
          "type": "integer",
          "minimum": 15,
          "maximum": 1440
        },
        "raw_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "daily_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 36500
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NAS Storage Analyzer deployment configuration v2 (Rust/React)"
}
